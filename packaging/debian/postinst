set -e

case "$1" in
    configure)
        # Reload udev rules (USB access for phones)
        if [ -x /bin/udevadm ]; then
            /bin/udevadm control --reload-rules || true
            /bin/udevadm trigger || true
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
