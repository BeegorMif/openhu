set -e

case "$1" in
    upgrade)
        # Packages before 1.0.0 shipped and enabled openhu.service; it is gone (OpenHU OS starts OpenHU with
        # its own unit). Remove its enable links while the old unit file is still there (the old prerm has
        # stopped it).
        if [ -f /lib/systemd/system/openhu.service ] && [ -x /bin/systemctl ]; then
            /bin/systemctl disable openhu.service >/dev/null 2>&1 || true
        fi
        ;;

    install|abort-upgrade)
        ;;

    *)
        echo "preinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
